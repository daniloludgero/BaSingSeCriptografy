# Normalize line endings across Linux, macOS, and Windows
* text=auto eol=lf

# Python & Shell scripts
*.py text eol=lf diff=python
*.sh text eol=lf

# Documentation & Web Lab assets
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# DIMACS CNF formulas
*.cnf text eol=lf linguist-generated=true
